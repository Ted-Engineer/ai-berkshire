#!/usr/bin/env bash
# SessionStart hook for ai-berkshire-investment plugin
# 当检测到 portfolio-rebalance 工作流激活时，注入质量契约到模型上下文

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PLUGIN_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
REPO_ROOT="$(cd "${PLUGIN_ROOT}/../../.." && pwd)"

# 检测是否有活跃的 rebalance workflow
WORKFLOW_ACTIVE="${REPO_ROOT}/.claude/.workflow/active"

if [ ! -f "$WORKFLOW_ACTIVE" ]; then
  # 无活跃workflow，不注入（避免每次会话都注入无关内容）
  exit 0
fi

# 读取质量契约内容
HARNESS_CONTENT='# Portfolio-Rebalance 执行质量契约（Hook自动注入）

## 最高优先级原则

**质量 > 速度。这是投资，不是赶作业。准确、全面的分析比省时间和token重要一万倍。**

## 四大师反退化铁律（每只持仓必须遵守）

1. 每只股票 = 4个独立GeneralPurpose Agent（段永平/巴菲特/芒格/李录）
2. 第1只到第N只，质量完全一致，不允许任何退化
3. 以"效率""节省""时间"为理由合并 = 对用户资金的不负责任
4. 每只完成后打印："✅ {TICKER}: 4个独立Agent已执行"
5. Agent数<4 → 该股票分析自动无效，必须重做

## 搜索正文铁律

- 发现阶段（找ticker）：可以只看标题
- 验证阶段（用于分析/决策）：必须fetch正文（fetchWebContent/WebFetch）
- 禁止仅凭snippet片段数字写入报告

## 阶段验证

每完成一个阶段，运行：
```bash
python3 scripts/rebalance-validate.py {stage_number}
```
输出 🔴 BLOCK = 该阶段不合规，必须修正后才能继续。

## 持仓上限与集中度

- ≤10只，各类top1/max top2
- 超过10只 → 按减仓优先级砍最弱的
- 八类：AI硬件/AI软件/AI平台/估值修复/爆发仓/加密/非AI对冲/现金'

# JSON转义
escape_for_json() {
    local s="$1"
    s="${s//\\/\\\\}"
    s="${s//\"/\\\"}"
    s="${s//$'\n'/\\n}"
    s="${s//$'\r'/\\r}"
    s="${s//$'\t'/\\t}"
    printf '%s' "$s"
}

escaped_content=$(escape_for_json "$HARNESS_CONTENT")

# 输出注入内容
session_context="<AI_BERKSHIRE_HARNESS>\n${escaped_content}\n</AI_BERKSHIRE_HARNESS>"

# 输出JSON（兼容Claude Code和Cursor格式）
if [ -n "${CURSOR_SESSION_ID:-}" ]; then
  printf '{"additional_context": "%s"}\n' "$session_context"
else
  printf '{"additional_context": "%s"}\n' "$session_context"
fi
